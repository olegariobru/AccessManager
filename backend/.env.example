DATABASE_URL="postgresql://usuario:senha@localhost:5432/access_manager"
NODE_ENV="development"
# Obrigatório em produção. Use credenciais próprias e rediss:// para Redis remoto.
# REDIS_URL="redis://localhost:6379/0"
# IPs/CIDRs EXATOS do proxy confiável; não use true ou número de saltos.
# TRUST_PROXY="127.0.0.1/32,::1/128"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Servidor SMTP usado para avisar os administradores.
SMTP_HOST="smtp.exemplo.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notificacoes@exemplo.com"
SMTP_PASS="senha-ou-token-do-provedor"
MAIL_FROM="AccessManager <notificacoes@exemplo.com>"
APP_TIMEZONE="America/Sao_Paulo"

# Diretório privado, fora de qualquer pasta pública, para PDFs protegidos.
# PRIVATE_STORAGE_DIR="C:/AccessManager/storage/private"
